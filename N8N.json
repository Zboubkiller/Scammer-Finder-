      "id": "cc2f9413-865a-4303-9aaf-85ce65e0e62f",
      "name": "Basic LLM Chain1"
    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  let webhookData = $('Webhook').first().json;\n  let body = webhookData.body || {};\n\n  if (body.activity && Array.isArray(body.activity)) {\n    body.activity = body.activity.slice(0, 15);\n  }\n  if (body.comments && Array.isArray(body.comments)) {\n    body.comments = body.comments.slice(0, 15);\n  }\n  if (body.posts && Array.isArray(body.posts)) {\n    body.posts = body.posts.slice(0, 15);\n  }\n\n  webhookData.body = body;\n  item.json = webhookData;\n}\n\nreturn $input.all();"
      },
